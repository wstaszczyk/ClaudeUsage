# macOS
.DS_Store
.AppleDouble
.LSOverride

# Xcode — personal editor state, not project config
xcuserdata/
*.xcuserstate
*.moved-aside
DerivedData/
*.xccheckout
*.xcscmblueprint

# Build artefacts
build/
*.o
*.a
*.d
*.dSYM/

# Claude Code local settings (permissions, launch config — machine-specific)
.claude/

# Private drafts and notes — never publish (UX audits, design brief drafts, etc.)
_private/

# Python cache
__pycache__/
*.pyc
